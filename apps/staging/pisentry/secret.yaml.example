---
# 1. cp secret.yaml.example secret.yaml and fill in real values
# 2. sops --config clusters/staging/.sops.yaml --encrypt --in-place apps/staging/pisentry/secret.yaml
# 3. uncomment "- secret.yaml" in kustomization.yaml, commit, push
# Never commit secret.yaml unencrypted. Never kubectl apply it directly; Flux decrypts.
apiVersion: v1
kind: Secret
metadata:
  name: pisentry-alerts
  namespace: pisentry
type: Opaque
stringData:
  # ntfy | discord | slack | generic
  alert-type: ntfy
  # ntfy: use a long random topic name, it is effectively the password
  webhook-url: https://ntfy.sh/CHANGE-ME-long-random-topic
  # optional bearer token (self-hosted ntfy with auth)
  webhook-token: ""
