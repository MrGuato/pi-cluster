---
# 1. cp secret.yaml.example secret.yaml and fill in both keys
# 2. sops --config clusters/staging/.sops.yaml --encrypt --in-place apps/staging/gitops-notes/secret.yaml
# 3. commit and push; Flux decrypts it at reconcile time
# Never commit secret.yaml unencrypted. Never kubectl apply it directly.
apiVersion: v1
kind: Secret
metadata:
  name: cloudflared-tunnel
  namespace: gitops-notes
type: Opaque
stringData:
  # The JSON that "cloudflared tunnel create gitops-notes" writes to
  # ~/.cloudflared/<TUNNEL_ID>.json, pasted as one line.
  credentials.json: |
    {"AccountTag":"REPLACE_ME","TunnelSecret":"REPLACE_ME","TunnelID":"REPLACE_WITH_TUNNEL_ID"}
  # Public hostname and in-cluster target. No Access policy is attached to
  # this hostname on purpose; see the README.
  config.yaml: |
    tunnel: REPLACE_WITH_TUNNEL_ID
    credentials-file: /etc/cloudflared/credentials.json
    metrics: 0.0.0.0:2000
    no-autoupdate: true
    ingress:
      - hostname: notes.deleontech.net
        service: http://gitops-notes:8080
      - service: http_status:404
